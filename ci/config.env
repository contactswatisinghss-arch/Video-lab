# Pipeline settings (Claude can change these; no workflow edit needed)
HF_VERSION=latest
WHISPER_MODEL=medium.en
SELFTEST_WHISPER_MODEL=small.en
REF_WHISPER_MODEL=small.en
HYPERFRAMES_NO_TELEMETRY=1
DO_NOT_TRACK=1
# full-quality renders with a background cutout can exceed the old 50 min default
RENDER_TIMEOUT=7200
